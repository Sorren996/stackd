{
  "name": "Evaluate notifications on new reading",
  "description": "After a real glucose reading is saved, evaluate the approved push categories for the person's own notifications and for each follower who has been permitted and has opted in. Carry-forward (system) readings are ignored, freshness and episodes are decided server-side, and each event is claimed once.",
  "trigger": {
    "condition": "${ .trigger.data.value != null and (.trigger.data.source // \"\") != \"system\" }",
    "config": {
      "trigger_type": "entity",
      "entity_name": "GlucoseReading",
      "events": [
        "create"
      ]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "evaluate_notifications_on_reading",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "evaluate_notifications": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "evaluateNotifications",
            "args": {
              "reading_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Evaluate notifications",
            "description": "Personal and follower push, claimed once"
          }
        }
      }
    ]
  }
}