{
  "name": "Re-anchor Projection on New Reading",
  "description": "Generates a server-side glucose projection immediately when a non-system GlucoseReading is created (e.g. manual logging), guarded by (user_id, anchor_time) so duplicate readings never create duplicate projections.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "GlucoseReading",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.source != \"system\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reanchor_projection_on_reading",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_projection": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateProjection",
            "args": {
              "workflow": true,
              "user_id": "${ (.trigger.data // {}).user_id // (.trigger.data // {}).created_by_id }",
              "entity_name": "${ .trigger.entity_name }",
              "entity_id": "${ .trigger.entity_id }",
              "event_type": "${ .trigger.event_type }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Generate projection",
            "description": "Re-anchor to the newest reading once per anchor"
          }
        }
      }
    ]
  }
}