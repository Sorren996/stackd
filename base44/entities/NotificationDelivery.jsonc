{
  "name": "NotificationDelivery",
  "type": "object",
  "properties": {
    "recipient_user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "shared_access_id": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "enum": [
        "self",
        "follower"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "urgent_low",
        "below_range",
        "above_range",
        "missing_readings",
        "custom_low",
        "custom_high",
        "falling_fast",
        "rising_fast"
      ],
      "enumColors": [
        "red",
        "yellow",
        "yellow",
        "gray",
        "blue",
        "purple",
        "pink",
        "green"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "push"
      ],
      "default": "push"
    },
    "event_key": {
      "type": "string"
    },
    "episode_key": {
      "type": "string"
    },
    "covered_events": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Every category/episode event coalesced into this single attempt; no glucose values."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "claimed",
        "submitted",
        "skipped",
        "failed",
        "unknown"
      ]
    },
    "reason": {
      "type": "string"
    },
    "detail_shown": {
      "type": "boolean",
      "default": false
    },
    "destination": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "permission_version": {
      "type": "number"
    }
  },
  "required": [
    "recipient_user_id",
    "category",
    "channel",
    "event_key",
    "status"
  ],
  "rls": {
    "read": {
      "data.recipient_user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}