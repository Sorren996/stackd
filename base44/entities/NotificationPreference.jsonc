{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of these preferences. Written from the authenticated user on the server, never from a client-supplied id."
    },
    "master_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master switch for this person's own native push notifications. Defaults to off; only an explicit opt-in turns it on."
    },
    "categories": {
      "type": "object",
      "description": "Per-category opt-ins. Every category defaults to off and is only turned on by the person themselves.",
      "properties": {
        "urgent_low": {
          "type": "boolean",
          "default": false
        },
        "below_range": {
          "type": "boolean",
          "default": false
        },
        "above_range": {
          "type": "boolean",
          "default": false
        },
        "missing_readings": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "above_range_minutes": {
      "type": "number",
      "description": "How long a sustained high has to last before it notifies, chosen explicitly by the person (15, 30 or 60). Null until they choose; never silently defaulted."
    },
    "missing_delay_minutes": {
      "type": "number",
      "description": "How long readings have to be quiet before a missing-readings notice is considered, chosen explicitly by the person (15, 20 or 30). Null until they choose; never silently defaulted."
    },
    "show_health_details": {
      "type": "boolean",
      "default": false,
      "description": "Whether previews may name the category, the measured value and the reading time. Off by default, so previews stay generic."
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": false
    },
    "quiet_start_hour": {
      "type": "number",
      "description": "Local hour (0-23) that quiet hours begin."
    },
    "quiet_end_hour": {
      "type": "number",
      "description": "Local hour (0-23) that quiet hours end. A window may wrap past midnight."
    },
    "quiet_timezone": {
      "type": "string",
      "description": "IANA timezone confirmed by the person, used to resolve quiet hours across daylight-saving changes."
    },
    "urgent_during_quiet": {
      "type": "boolean",
      "default": false,
      "description": "Separate, explicit option allowing urgent-low notifications inside this person's quiet hours. Defaults to off."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}