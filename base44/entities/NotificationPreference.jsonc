{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "master_enabled": {
      "type": "boolean",
      "default": false
    },
    "categories": {
      "type": "object",
      "properties": {
        "low_glucose": {
          "type": "boolean",
          "description": "Explicit fixed below-70 choice. Absent preserves an existing below_range choice only when its boundary is exactly 70; never auto-enabled."
        },
        "urgent_low": {
          "type": "boolean",
          "default": false
        },
        "below_range": {
          "type": "boolean",
          "default": false
        },
        "above_range": {
          "type": "boolean",
          "default": false
        },
        "missing_readings": {
          "type": "boolean",
          "default": false
        },
        "custom_low": {
          "type": "boolean",
          "default": false
        },
        "custom_high": {
          "type": "boolean",
          "default": false
        },
        "falling_fast": {
          "type": "boolean",
          "default": false
        },
        "rising_fast": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "category_activation": {
      "type": "object",
      "description": "Server-generated per-category explicit opt-in markers; not accepted from request input."
    },
    "custom_low_mgdl": {
      "type": "number",
      "minimum": 60,
      "maximum": 150,
      "description": "Notification-only low; canonical mg/dL, never a calculation input."
    },
    "custom_high_mgdl": {
      "type": "number",
      "minimum": 100,
      "maximum": 400,
      "description": "Notification-only high; canonical mg/dL, never a calculation input."
    },
    "custom_high_minutes": {
      "type": "number",
      "enum": [
        0,
        15,
        30,
        60
      ],
      "default": 0
    },
    "falling_fast_rate": {
      "type": "number",
      "enum": [
        2,
        3
      ]
    },
    "rising_fast_rate": {
      "type": "number",
      "enum": [
        2,
        3
      ]
    },
    "falling_fast_level_mgdl": {
      "type": "number",
      "minimum": 40,
      "maximum": 400
    },
    "rising_fast_level_mgdl": {
      "type": "number",
      "minimum": 40,
      "maximum": 400
    },
    "repeat_minutes": {
      "type": "object",
      "description": "Explicit per-category repeats, 15/30/60/120 minutes; absent/null means once per episode. Fixed low and urgent low ignore legacy repeats."
    },
    "above_range_minutes": {
      "type": "number"
    },
    "missing_delay_minutes": {
      "type": "number"
    },
    "show_health_details": {
      "type": "boolean",
      "default": false
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": false
    },
    "quiet_start_hour": {
      "type": "number"
    },
    "quiet_end_hour": {
      "type": "number"
    },
    "quiet_timezone": {
      "type": "string"
    },
    "urgent_during_quiet": {
      "type": "boolean",
      "default": false
    },
    "all_readings_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Owner only: one quiet note for each new reading. Followers can never enable this, and it is hidden for follower accounts. A reading that already produced an alert never produces a second, stream notice."
    },
    "all_readings_pause_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Pause window for the all-readings stream only. Every alert above keeps its own settings."
    },
    "all_readings_pause_start_hour": {
      "type": "number",
      "minimum": 0,
      "maximum": 23,
      "description": "Local hour the all-readings pause begins. A window may cross midnight."
    },
    "all_readings_pause_end_hour": {
      "type": "number",
      "minimum": 0,
      "maximum": 23,
      "description": "Local hour the all-readings pause ends. Exclusive."
    },
    "all_readings_pause_timezone": {
      "type": "string",
      "description": "IANA zone the pause window is evaluated in, stored so daylight saving resolves itself."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}