{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Display name of the user these settings belong to, for identification in the backend."
    },
    "timezone": {
      "type": "string",
      "description": "User's IANA timezone identifier (e.g. America/Chicago), saved from the browser so the AI Coach can reference times in the user's local timezone."
    },
    "insulin_sensitivity_mgdl_per_unit": {
      "type": "number",
      "description": "How much 1 unit of insulin typically lowers glucose (mg/dL per unit). Must come from the user's established insulin plan."
    },
    "correction_target_glucose": {
      "type": "number",
      "description": "Glucose baseline used when estimating correction insulin (mg/dL)."
    },
    "meal_insulin_units_per_5g": {
      "type": "number",
      "description": "Insulin units used to cover 5 grams of carbohydrates."
    },
    "insulin_library": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every insulin type the user personally uses. Only these appear in the logging dropdown."
    },
    "meal_insulin_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Insulin types used for meals or corrections \u2014 the subset of the library used by the meal balance card."
    },
    "meal_prebolus_window_minutes": {
      "type": "number",
      "description": "How far before the first carb log an insulin dose can still be paired with that meal."
    },
    "meal_postbolus_window_minutes": {
      "type": "number",
      "description": "How far after the last carb log an insulin dose can still be paired with that meal."
    },
    "meal_outcome_window_minutes": {
      "type": "number",
      "description": "How long after a meal the app should keep reviewing that grouped meal."
    },
    "target_range_low": {
      "type": "number",
      "description": "Lower bound of the user's target glucose range (mg/dL)."
    },
    "target_range_high": {
      "type": "number",
      "description": "Upper bound of the user's target glucose range (mg/dL)."
    },
    "stacking_alerts_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether insulin stacking warnings are shown."
    },
    "glucose_units": {
      "type": "string",
      "enum": [
        "mg/dL",
        "mmol/L"
      ],
      "default": "mg/dL",
      "description": "Display units for glucose values."
    },
    "graph_height": {
      "type": "number",
      "enum": [
        300,
        400
      ],
      "default": 400,
      "description": "User's preferred normal upper Y-axis display limit for the Your Flow glucose graph (mg/dL). Display-only preference; never clamps, discards, or overwrites raw glucose values. The graph may temporarily expand beyond this when visible data exceeds it."
    },
    "settings_migrated_from_local": {
      "type": "boolean",
      "default": false,
      "description": "Whether local storage settings were migrated to the server."
    },
    "coach_reviews_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether periodic AI Wellness Coach background reviews are active."
    },
    "coach_insight_notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the dashboard leaf glows amber for new Coach insights."
    },
    "coach_exclude_journal": {
      "type": "boolean",
      "default": false,
      "description": "Whether journal entries are excluded from AI Coach review."
    },
    "coach_last_review_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last successful Coach background review, used for cooldown."
    }
  },
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "required": []
}