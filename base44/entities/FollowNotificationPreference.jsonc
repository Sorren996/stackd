{
  "name": "FollowNotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The follower these preferences belong to. Always the authenticated user on the server, never a client-supplied id."
    },
    "shared_access_id": {
      "type": "string",
      "description": "The sharing relationship these preferences apply to. Re-verified as active and glucose-scoped on every evaluation."
    },
    "master_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master switch for push about this one person. Off by default; the follower opts in themselves."
    },
    "categories": {
      "type": "object",
      "description": "The follower's own subset. It can only narrow what the sharer has permitted, never broaden it.",
      "properties": {
        "urgent_low": {
          "type": "boolean",
          "default": false
        },
        "below_range": {
          "type": "boolean",
          "default": false
        },
        "above_range": {
          "type": "boolean",
          "default": false
        },
        "missing_readings": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "missing_delay_minutes": {
      "type": "number",
      "description": "The follower's own choice of how long readings must be quiet before a missing-readings notice (15, 20 or 30). Null until they choose; never silently defaulted."
    },
    "show_health_details": {
      "type": "boolean",
      "default": false,
      "description": "Whether this follower's previews may include the category, value and reading time. Off by default; generic previews never name the person."
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": false
    },
    "quiet_start_hour": {
      "type": "number"
    },
    "quiet_end_hour": {
      "type": "number"
    },
    "quiet_timezone": {
      "type": "string",
      "description": "IANA timezone confirmed by the follower."
    },
    "urgent_during_quiet": {
      "type": "boolean",
      "default": false,
      "description": "Separate, explicit option allowing urgent-low notifications inside this follower's quiet hours. Defaults to off."
    }
  },
  "required": [
    "user_id",
    "shared_access_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}