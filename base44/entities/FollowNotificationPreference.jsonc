{
  "name": "FollowNotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "shared_access_id": {
      "type": "string"
    },
    "master_enabled": {
      "type": "boolean",
      "default": false
    },
    "categories": {
      "type": "object",
      "properties": {
        "urgent_low": {
          "type": "boolean",
          "default": false
        },
        "below_range": {
          "type": "boolean",
          "default": false
        },
        "above_range": {
          "type": "boolean",
          "default": false
        },
        "missing_readings": {
          "type": "boolean",
          "default": false
        },
        "custom_low": {
          "type": "boolean",
          "default": false
        },
        "custom_high": {
          "type": "boolean",
          "default": false
        },
        "falling_fast": {
          "type": "boolean",
          "default": false
        },
        "rising_fast": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "category_activation": {
      "type": "object",
      "description": "Server-generated explicit opt-in markers, never trusted from a submitted preference body."
    },
    "custom_low_mgdl": {
      "type": "number",
      "minimum": 60,
      "maximum": 150,
      "description": "Notification-only threshold, canonical mg/dL."
    },
    "custom_high_mgdl": {
      "type": "number",
      "minimum": 100,
      "maximum": 400,
      "description": "Notification-only threshold, canonical mg/dL."
    },
    "custom_high_minutes": {
      "type": "number",
      "enum": [
        0,
        15,
        30,
        60
      ],
      "default": 0
    },
    "falling_fast_rate": {
      "type": "number",
      "enum": [
        2,
        3
      ]
    },
    "rising_fast_rate": {
      "type": "number",
      "enum": [
        2,
        3
      ]
    },
    "falling_fast_level_mgdl": {
      "type": "number",
      "minimum": 40,
      "maximum": 400
    },
    "rising_fast_level_mgdl": {
      "type": "number",
      "minimum": 40,
      "maximum": 400
    },
    "repeat_minutes": {
      "type": "object",
      "description": "Explicit per-direction/category repeat intervals only; missing means once."
    },
    "above_range_minutes": {
      "type": "number"
    },
    "missing_delay_minutes": {
      "type": "number"
    },
    "show_health_details": {
      "type": "boolean",
      "default": false
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": false
    },
    "quiet_start_hour": {
      "type": "number"
    },
    "quiet_end_hour": {
      "type": "number"
    },
    "quiet_timezone": {
      "type": "string"
    },
    "urgent_during_quiet": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "shared_access_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}