{
  "name": "NotificationLedger",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Server-owned recipient."
    },
    "scope_key": {
      "type": "string",
      "description": "self or follow:<relationship id>."
    },
    "claimed_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "pruned_at": {
      "type": "string",
      "format": "date-time"
    },
    "episode_revision": {
      "type": "number",
      "description": "CAS revision serializing episode decisions across concurrent workflows."
    },
    "episode_state": {
      "type": "object",
      "description": "Server-only per-category state, sample watermark, recovery counts, episode and repeat identities; no glucose values."
    }
  },
  "required": [
    "user_id",
    "scope_key"
  ],
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}