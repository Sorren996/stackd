{
  "name": "MealResponseModelState",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Explicit user ID for service-role created state, so the owning user can read it."
    },
    "model_version": {
      "type": "string",
      "description": "Version of the meal-response model backing this user's state. Separate from the general forecast model version."
    },
    "speed_class_parameters": {
      "type": "object",
      "description": "Per speed-class learned parameters (speed factors for fast, mixed, high_fat). Each entry has { speed_factor, sample_count }. Separate from the general forecast model's rateAdjustmentFactor. Empty for baseline."
    },
    "sample_counts_by_class": {
      "type": "object",
      "description": "Sample counts per speed class: { fast: number, mixed: number, high_fat: number }. Zero means no learned timing for that class yet."
    },
    "evaluation_summary": {
      "type": "object",
      "description": "Aggregate meal-response evaluation metrics filled in future milestones when meal-specific learning is activated."
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the meal-response state was last updated."
    },
    "baseline_locked": {
      "type": "boolean",
      "default": true,
      "description": "Whether the meal-response state is still at baseline (no per-class personalization applied). True until future milestones activate meal-specific learning with sufficient evidence."
    },
    "update_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Chronological log of every accepted meal-response parameter update: timestamp, speed_class, previous_factor, new_factor, sample_count, reason."
    }
  },
  "required": [
    "model_version",
    "baseline_locked"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}