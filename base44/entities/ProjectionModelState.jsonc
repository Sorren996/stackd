{
  "name": "ProjectionModelState",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Explicit user ID for service-role created state, so the owning user can read it."
    },
    "model_version": {
      "type": "string",
      "description": "Current model version backing this user's projection state. '1.0.0-baseline' when no personalization has been applied; '1.1.0-personalized' when a learned rateAdjustmentFactor is active."
    },
    "parameters": {
      "type": "object",
      "description": "Personalized model parameters. Contains rateAdjustmentFactor (multiplicative adjustment to the net glucose rate, baseline 1.0) when personalization is active. Empty for baseline.",
      "properties": {
        "rateAdjustmentFactor": {
          "type": "number",
          "description": "Multiplicative factor applied to the net glucose rate (carbRise - insulinDrop + momentum). Baseline = 1.0. Clamped to [0.7, 1.3]. <1.0 slows the projected change; >1.0 accelerates it."
        }
      }
    },
    "sample_count": {
      "type": "number",
      "default": 0,
      "description": "Number of evaluated predictions that have contributed to this state. Zero means baseline, no personalization yet."
    },
    "evaluation_summary": {
      "type": "object",
      "description": "Aggregate evaluation metrics from the most recent update cycle: mae, bias, coverage, byHorizon, byModelVersion."
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the state was last updated by the evaluation pipeline."
    },
    "baseline_locked": {
      "type": "boolean",
      "default": true,
      "description": "Whether the state is still at baseline (no personalization applied, or personalization was reverted). True = baseline is the active model."
    },
    "update_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Chronological log of every accepted parameter update or reversion: timestamp, previous_params, new_params, sample_count, reason, model_version, evaluation_version, evaluation_summary."
    }
  },
  "required": [
    "model_version",
    "sample_count"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}