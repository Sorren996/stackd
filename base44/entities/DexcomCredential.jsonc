{
  "name": "DexcomCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of these credentials. Set only by the server."
    },
    "connection_id": {
      "type": "string",
      "description": "The DexcomConnection record these credentials belong to."
    },
    "username_enc": {
      "type": "string",
      "description": "Dexcom Share username, AES-256-GCM ciphertext (v1:base64(iv|ciphertext|tag)). Key lives only in the DEXCOM_CREDENTIAL_ENCRYPTION_KEY server secret."
    },
    "password_enc": {
      "type": "string",
      "description": "Dexcom Share password, AES-256-GCM ciphertext (v1:base64(iv|ciphertext|tag)). Key lives only in the DEXCOM_CREDENTIAL_ENCRYPTION_KEY server secret."
    },
    "key_version": {
      "type": "string",
      "default": "v1",
      "description": "Encryption format/key version."
    }
  },
  "required": [
    "user_id",
    "username_enc",
    "password_enc"
  ],
  "rls": {
    "read": false,
    "delete": false,
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}