{
  "name": "SharedAccess",
  "type": "object",
  "properties": {
    "sharer_user_id": {
      "type": "string",
      "description": "Immutable account ID of the person sharing their data. Written once at invitation time and never reassigned."
    },
    "sharer_display_name": {
      "type": "string"
    },
    "invited_email": {
      "type": "string",
      "description": "Normalized intended recipient email."
    },
    "follower_user_id": {
      "type": "string"
    },
    "scopes": {
      "type": "object",
      "properties": {
        "glucose": {
          "type": "boolean",
          "default": false
        },
        "insulin": {
          "type": "boolean",
          "default": false
        },
        "location": {
          "type": "boolean",
          "default": false
        },
        "urgent_low_call": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "alert_scopes": {
      "type": "object",
      "description": "Independent email/SMS permissions, never inferred from push opt-ins.",
      "properties": {
        "urgent_low_email": {
          "type": "boolean",
          "default": false
        },
        "urgent_low_sms": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "push": {
      "type": "object",
      "description": "Explicit per-follower native push grants; glucose scope also required; absent means off.",
      "properties": {
        "urgent_low": {
          "type": "boolean",
          "default": false
        },
        "below_range": {
          "type": "boolean",
          "default": false
        },
        "above_range": {
          "type": "boolean",
          "default": false
        },
        "missing_readings": {
          "type": "boolean",
          "default": false
        },
        "custom_low": {
          "type": "boolean",
          "default": false
        },
        "custom_high": {
          "type": "boolean",
          "default": false
        },
        "falling_fast": {
          "type": "boolean",
          "default": false
        },
        "rising_fast": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "contact_shared": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "paused",
        "expired",
        "revoked"
      ],
      "default": "pending"
    },
    "permission_version": {
      "type": "number",
      "default": 1
    },
    "invitation_id": {
      "type": "string"
    },
    "invitation_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_scope_change_at": {
      "type": "string",
      "format": "date-time"
    },
    "follower_prefs": {
      "type": "object",
      "properties": {
        "notify_email": {
          "type": "boolean",
          "default": false
        },
        "notify_sms": {
          "type": "boolean",
          "default": false
        },
        "quiet_hours_start": {
          "type": "number",
          "default": 21
        },
        "quiet_hours_end": {
          "type": "number",
          "default": 7
        }
      }
    }
  },
  "required": [
    "sharer_user_id",
    "invited_email",
    "status",
    "permission_version"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.follower_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}