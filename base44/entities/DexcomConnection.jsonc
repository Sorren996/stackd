{
  "name": "DexcomConnection",
  "type": "object",
  "properties": {
    "share_username": {
      "type": "string",
      "description": "The user's Dexcom Share (publisher) account username or email. Used to authenticate with the Dexcom Share service for near-real-time glucose readings."
    },
    "share_password": {
      "type": "string",
      "description": "The user's Dexcom Share (publisher) account password. Stored securely via row-level security so only the owning user and the background sync service can access it."
    },
    "connected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user connected their Dexcom Share account"
    },
    "last_fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the auto-sync last pulled readings for this connection"
    },
    "last_sync_status": {
      "type": "string",
      "description": "Result of the most recent sync attempt (synced, no_new_records, error, session_expired, etc.)"
    },
    "last_sync_error": {
      "type": "string",
      "description": "Error message from the most recent failed sync, if any. Cleared on successful sync."
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "default": "connected",
      "description": "Current state of the Dexcom Share connection"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}