{
  "name": "GlucoseReading",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Explicit user ID for service-role created readings (e.g. from a connected glucose source or system-generated carry-forward). Lets the owning user read imported readings."
    },
    "value": {
      "type": "number",
      "description": "Blood glucose value in mg/dL"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reading was taken"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "dexcom",
        "system"
      ],
      "default": "manual",
      "description": "Whether this reading was entered by hand, imported from a connected glucose source, or generated by the system to carry forward the last known value during gaps"
    },
    "trend": {
      "type": "string",
      "description": "Native trend indicator from the connected glucose source (e.g. Dexcom trend arrow string like doubleUp, flat, singleDown). Used to display the source's own trend rather than a computed estimate."
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Server-side archive flag. Automatically set to true once the log is older than 14 days. Locked logs are read-only and cannot be edited or deleted."
    }
  },
  "required": [
    "value",
    "recorded_at"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_locked": {
            "$ne": true
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_locked": {
            "$ne": true
          }
        }
      ]
    }
  }
}