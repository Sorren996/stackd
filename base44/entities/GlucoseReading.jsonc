{
  "name": "GlucoseReading",
  "type": "object",
  "properties": {
    "value": {
      "type": "number",
      "description": "Blood glucose value in mg/dL"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reading was taken"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Server-side archive flag. Automatically set to true once the log is older than 14 days. Locked logs are read-only and cannot be edited or deleted."
    }
  },
  "required": [
    "value",
    "recorded_at"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_locked": {
            "$ne": true
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_locked": {
            "$ne": true
          }
        }
      ]
    }
  }
}