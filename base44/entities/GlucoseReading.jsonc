{
  "name": "GlucoseReading",
  "type": "object",
  "properties": {
    "value": {
      "type": "number",
      "description": "Blood glucose value in mg/dL"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reading was taken"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "value",
    "recorded_at"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}