{
  "name": "InsulinDose",
  "type": "object",
  "properties": {
    "insulin_type": {
      "type": "string",
      "enum": [
        "Novolog (Aspart)",
        "Humalog (Lispro)",
        "Apidra (Glulisine)",
        "Regular (Novolin R / Humulin R)",
        "NPH (Novolin N / Humulin N)",
        "Lantus (Glargine)",
        "Levemir (Detemir)",
        "Tresiba (Degludec)"
      ]
    },
    "units": {
      "type": "number"
    },
    "administered_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Server-side archive flag. Automatically set to true once the log is older than 14 days. Locked logs are read-only and cannot be edited or deleted."
    }
  },
  "required": [
    "insulin_type",
    "units",
    "administered_at"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_locked": {
            "$ne": true
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_locked": {
            "$ne": true
          }
        }
      ]
    }
  }
}