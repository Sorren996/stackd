{
  "name": "ProjectionResidual",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "projection_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_version": {
      "type": "string"
    },
    "context": {
      "type": "object"
    },
    "volatility_sd": {
      "type": "number"
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scoring_version": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "projection_id",
    "generated_at",
    "scores",
    "scoring_version"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}