{
  "name": "ProjectionBandState",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "coverage_scale": {
      "type": "number",
      "default": 1
    },
    "coverage_key": {
      "type": "string"
    },
    "coverage": {
      "type": "number"
    },
    "coverage_count": {
      "type": "number"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}