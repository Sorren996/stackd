{
  "name": "CarbEntry",
  "type": "object",
  "properties": {
    "food_name": {
      "type": "string",
      "description": "Name of the food consumed"
    },
    "is_custom": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a custom food without a validated absorption profile"
    },
    "carbs": {
      "type": "number",
      "description": "Total carbohydrates in grams"
    },
    "serving_amount": {
      "type": "number",
      "default": 1,
      "description": "Number of servings consumed"
    },
    "glycemic_index": {
      "type": "number",
      "description": "Glycemic index of the food"
    },
    "absorption_profile": {
      "type": "string",
      "enum": [
        "fast",
        "medium",
        "slow"
      ],
      "description": "Absorption speed profile"
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the food was consumed"
    },
    "is_high_protein_fat_meal": {
      "type": "boolean",
      "default": false,
      "description": "Whether this meal was flagged as high protein or high fat for monitoring purposes"
    },
    "classification": {
      "type": "string",
      "enum": [
        "meal",
        "snack",
        "rescue_carbs"
      ],
      "description": "AI-assisted classification of this nourishment entry. Set automatically by the classifyLogEntry backend function shortly after creation."
    },
    "classification_reasoning": {
      "type": "string",
      "description": "Brief wellness-focused reasoning behind the AI classification"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Server-side archive flag. Automatically set to true once the log is older than 14 days. Locked logs are read-only and cannot be edited or deleted."
    }
  },
  "required": [
    "food_name",
    "carbs",
    "consumed_at"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_locked": {
            "$ne": true
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_locked": {
            "$ne": true
          }
        }
      ]
    }
  }
}