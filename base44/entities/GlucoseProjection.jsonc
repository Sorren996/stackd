{
  "name": "GlucoseProjection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Explicit user ID for service-role created projections, so the owning user can read them."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the projection was generated. This is the prediction timestamp \u2014 only information available at this time was used."
    },
    "model_version": {
      "type": "string",
      "description": "Version of the projection model that produced this prediction: '1.0.0-baseline' or '1.1.0-personalized'. Used to compare baseline vs personalized performance."
    },
    "meal_response_model_version": {
      "type": "string",
      "description": "Version of the meal-response model active when this prediction was made: '1.0.0-meal-baseline' or '1.1.0-meal-personalized'. Separate from the general forecast model version so meal-response personalization can be evaluated independently."
    },
    "anchor_time": {
      "type": "string",
      "format": "date-time",
      "description": "Time of the latest valid CGM reading the projection starts from."
    },
    "anchor_value": {
      "type": "number",
      "description": "Glucose value at the anchor reading (mg/dL)."
    },
    "horizon_minutes": {
      "type": "number",
      "description": "How far forward the projection extends in minutes."
    },
    "trajectory": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Time-indexed projected glucose values, each { time, min_offset, value, lower, upper }. Empty when the engine abstained."
    },
    "uncertainty_summary": {
      "type": "object",
      "description": "Calibrated uncertainty metadata: base_sigma, widening factors, band type."
    },
    "data_quality": {
      "type": "object",
      "description": "Data quality and confounder flags at generation time: stale_readings, gap_present, reading_count, active_meal_count, active_dose_count, calibrated, confounders."
    },
    "input_provenance": {
      "type": "object",
      "description": "Compact summary of inputs used (counts, time range, settings hash) for auditability \u2014 never full raw data."
    },
    "active_inputs": {
      "type": "object",
      "description": "Summary of active carbs and insulin at generation time: total_active_carb_grams, total_active_insulin_units, meal_count, dose_count, active_speed_classes."
    },
    "model_resolution": {
      "type": "object",
      "description": "Milestone 4: explicit model arbitration provenance. Records which model components (general forecast-bias correction, per-class meal-response correction) were eligible, their effective values, and the selection/rejection reason for each. Contains: general {eligible, effectiveValue, reason, source}, meal {eligible, classes, reason, eligibleClasses}, modelVersion, mealModelVersion, isIntegrated, resolutionReason."
    },
    "effective_parameters": {
      "type": "object",
      "description": "Milestone 4: the exact parameter values used to generate this projection. Contains: rateAdjustmentFactor (number), mealParams (per-class {speedFactor, magnitudeFactor} or null). Immutable once persisted \u2014 represents the model state at generation time."
    },
    "uncertainty_info": {
      "type": "object",
      "description": "Milestone 4: uncertainty method and calibration status. Contains: method ('heuristic' or 'empirical_calibrated'), version, calibrated (boolean), sampleCount (evaluated projections used for calibration), coverageObserved (measured interval coverage or null when insufficient). An interval is NOT claimed to be calibrated until coverage has been measured on suitable observations."
    },
    "shadow_evaluation": {
      "type": "object",
      "description": "Milestone 4: shadow evaluation results comparing alternative model configurations on the same eligible observations. Contains per-config metrics (baseline, general_personalized, meal_personalized, integrated) with mae, bias, coverage, valid_count. Only populated by the evaluation pipeline after the forecast window has elapsed. Does not modify the original trajectory."
    },
    "confidence": {
      "type": "number",
      "description": "Overall confidence in the projection, 0 to 1. Low confidence widens the uncertainty band."
    },
    "abstained": {
      "type": "boolean",
      "default": false,
      "description": "Whether the engine abstained from producing a trajectory due to insufficient evidence."
    },
    "abstain_reason": {
      "type": "string",
      "description": "Why the engine abstained, when abstained is true."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "evaluated",
        "unscorable",
        "superseded"
      ],
      "default": "active",
      "description": "Whether the prediction is still awaiting outcome data, has been evaluated against actuals, was unscorable (no observations available), or superseded by a newer projection."
    },
    "evaluation": {
      "type": "object",
      "description": "Filled by the Milestone 2 evaluation pipeline when actual outcomes are compared: status (evaluated/unscorable), reason, horizons [{horizon_min, scored, predicted, actual, error, abs_error, in_interval, exclusion_reason}], mae, bias, coverage, valid_count, excluded_count, exclusions, evaluation_version, evaluated_at."
    }
  },
  "required": [
    "generated_at",
    "model_version",
    "anchor_time",
    "anchor_value",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}