{
  "name": "GlucoseProjection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner ID for server-created projections."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_version": {
      "type": "string"
    },
    "meal_response_model_version": {
      "type": "string"
    },
    "anchor_time": {
      "type": "string",
      "format": "date-time"
    },
    "anchor_value": {
      "type": "number"
    },
    "measured_velocity_mgdl_per_min": {
      "type": "number"
    },
    "applied_momentum": {
      "type": "object"
    },
    "carb_rate_at_anchor": {
      "type": "number",
      "description": "Sum of positive meal and rescue appearance rates at the anchor, mg/dL/min, before summing with support and momentum."
    },
    "active_carbs": {
      "type": "number",
      "description": "Grams not yet absorbed, computed from the exact per-entry curves used in this forecast."
    },
    "carb_sensitivity_mgdl_per_gram": {
      "type": "number",
      "description": "Forecast conversion from the person's saved ratio and sensitivity, never written back to settings."
    },
    "meal_components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "carbs": {
            "type": "number"
          },
          "onset": {
            "type": "number"
          },
          "peak": {
            "type": "number"
          },
          "duration": {
            "type": "number"
          },
          "amplitude": {
            "type": "number"
          },
          "source": {
            "type": "string",
            "enum": [
              "theoretical",
              "learned"
            ]
          },
          "sample_count": {
            "type": "number"
          },
          "learning_weight": {
            "type": "number"
          },
          "bucket": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "carbs",
          "onset",
          "peak",
          "duration",
          "amplitude",
          "source"
        ]
      }
    },
    "horizon_minutes": {
      "type": "number"
    },
    "trajectory": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "uncertainty_summary": {
      "type": "object"
    },
    "data_quality": {
      "type": "object"
    },
    "input_snapshot": {
      "type": "object",
      "description": "Immutable available-at-generation readings, meals, support, settings and forecast-only learning state for leakage-free replay."
    },
    "input_provenance": {
      "type": "object"
    },
    "active_inputs": {
      "type": "object"
    },
    "model_resolution": {
      "type": "object"
    },
    "effective_parameters": {
      "type": "object"
    },
    "uncertainty_info": {
      "type": "object"
    },
    "shadow_evaluation": {
      "type": "object"
    },
    "shadow_eligibility": {
      "type": "object"
    },
    "confidence": {
      "type": "number"
    },
    "abstained": {
      "type": "boolean",
      "default": false
    },
    "abstain_reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "processing",
        "evaluated",
        "unscorable",
        "superseded"
      ],
      "default": "active"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation": {
      "type": "object"
    }
  },
  "required": [
    "generated_at",
    "model_version",
    "anchor_time",
    "anchor_value",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}